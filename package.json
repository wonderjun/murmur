{
  "name": "murmur",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Murmur — menu-bar status companion for AI coding agents.",
  "license": "MIT",
  "author": "wangjun <chen-wang-jun@foxmail.com> (https://github.com/chen-wang-jun)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chen-wang-jun/murmur.git"
  },
  "bugs": "https://github.com/chen-wang-jun/murmur/issues",
  "homepage": "https://github.com/chen-wang-jun/murmur#readme",
  "keywords": [
    "menubar",
    "ai-agents",
    "macos",
    "electrobun",
    "status-monitor"
  ],
  "scripts": {
    "dev": "cd apps/desktop && hutch run dev",
    "dev:hmr": "cd apps/desktop && hutch run dev:hmr",
    "build": "cd apps/desktop && hutch run build",
    "test": "cd packages/core && bun test",
    "test:desktop": "bun test apps/desktop/test/rpc-contract.test.ts apps/desktop/test/architecture-boundary.test.ts apps/desktop/test/focus-app.test.ts apps/desktop/test/updates.test.ts scripts/sync-desktop-tsconfig.test.ts",
    "typecheck": "cd packages/core && bunx tsc --noEmit",
    "typecheck:desktop": "cd apps/desktop && bunx tsc --noEmit",
    "lint": "cd apps/desktop && bunx eslint .",
    "lint:fix": "cd apps/desktop && bunx eslint . --fix",
    "format": "cd apps/desktop && bunx prettier --write .",
    "sync:tsconfig": "bun scripts/sync-desktop-tsconfig.ts",
    "check:tsconfig": "bun scripts/sync-desktop-tsconfig.ts --check"
  }
}
